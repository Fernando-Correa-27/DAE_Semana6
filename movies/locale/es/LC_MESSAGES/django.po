# ---------------------------------------------------------------------------
# django.forms.fields / django.core.validators -- mensajes de validacion
# basicos. Son los que aparecen junto a los labels en espanol ("Puntuacion",
# "Correo electronico", ...), por lo que tienen que estar traducidos.
# ---------------------------------------------------------------------------

#: django/forms/fields.py
msgid "This field is required."
msgstr "Este campo es obligatorio."

#: django/core/validators.py
msgid "Enter a valid email address."
msgstr "Introduzca una dirección de correo electrónico válida."

#: django/core/validators.py django/forms/fields.py
msgid "Enter a valid URL."
msgstr "Introduzca una URL válida."

#: django/forms/fields.py
msgid "Enter a whole number."
msgstr "Introduzca un número entero."

#: django/forms/fields.py
msgid "Enter a valid decimal number."
msgstr "Introduzca un número decimal válido."

#: django/forms/fields.py
msgid "Enter a valid integer."
msgstr "Introduzca un número entero válido."

#: django/forms/fields.py
msgid "Enter a valid value."
msgstr "Introduzca un valor válido."

#: django/core/validators.py
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "Escoja una opción válida. %(value)s no es una de las opciones disponibles."

#: django/forms/fields.py
msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Escoja una opción válida. Esa opción no es una de las opciones disponibles."

#: django/core/validators.py
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Este valor debe ser mayor o igual que %(limit_value)s."

#: django/core/validators.py
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Este valor debe ser menor o igual que %(limit_value)s."

#: django/core/validators.py
msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr "Este valor debe ser %(limit_value)s (es %(show_value)s)."

#: django/core/validators.py
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Este valor debe ser un múltiplo del tamaño de paso %(limit_value)s."

#: django/core/validators.py
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at least %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Este valor debe tener al menos %(limit_value)d carácter (tiene "
"%(show_value)d)."
msgstr[1] ""
"Este valor debe tener al menos %(limit_value)d caracteres (tiene "
"%(show_value)d)."

#: django/core/validators.py
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Este valor debe tener como máximo %(limit_value)d carácter (tiene "
"%(show_value)d)."
msgstr[1] ""
"Este valor debe tener como máximo %(limit_value)d caracteres (tiene "
"%(show_value)d)."

#: django/core/validators.py
msgid "Null characters are not allowed."
msgstr "No se permiten caracteres nulos."

#: django/core/validators.py
msgid "Enter a valid domain name."
msgstr "Introduzca un nombre de dominio válido."

# ---------------------------------------------------------------------------
# django.contrib.auth -- validacion de contrasenas y de nombre de usuario
# ---------------------------------------------------------------------------

#: django/contrib/auth/validators.py
msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"Introduzca un nombre de usuario válido. Este valor solo puede contener "
"letras, números y los caracteres @/./+/-/_."

#: django/contrib/auth/validators.py
msgid ""
"Enter a valid username. This value may contain only unaccented lowercase a-z "
"and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr ""
"Introduzca un nombre de usuario válido. Este valor solo puede contener "
"letras minúsculas a-z sin acentos, mayúsculas A-Z, números y los "
"caracteres @/./+/-/_."

#: django/contrib/auth/models.py
msgid "A user with that username already exists."
msgstr "Ya existe un usuario con ese nombre de usuario."

#: django/contrib/auth/models.py
msgid "Username already exists."
msgstr "El nombre de usuario ya existe."

#: django/contrib/auth/forms.py
msgid "The two password fields didn’t match."
msgstr "Las dos contraseñas no coinciden."

#: django/contrib/auth/password_validation.py
msgid "This password is too common."
msgstr "Esta contraseña es demasiado común."

#: django/contrib/auth/password_validation.py
msgid "This password is entirely numeric."
msgstr "Esta contraseña es completamente numérica."

#: django/contrib/auth/password_validation.py
msgid "The password is too similar to the %(verbose_name)s."
msgstr "La contraseña es demasiado similar al %(verbose_name)s."

#: django/contrib/auth/password_validation.py
msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Esta contraseña es demasiado corta. Debe contener al menos %d carácter."
msgstr[1] "Esta contraseña es demasiado corta. Debe contener al menos %d caracteres."

#: django/contrib/auth/password_validation.py
msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Su contraseña debe contener al menos %(min_length)d carácter."
msgstr[1] "Su contraseña debe contener al menos %(min_length)d caracteres."

# ---------------------------------------------------------------------------
# Unicidad -- django.db.models y django.forms
# ---------------------------------------------------------------------------

#: django/db/models/fields/__init__.py django/db/models/base.py
msgid "This field must be unique."
msgstr "Este campo debe ser único."

#: django/db/models/fields/__init__.py
msgid "%(model_name)s with this %(field_label)s already exists."
msgstr "Ya existe %(model_name)s con este %(field_label)s."

#: django/db/models/base.py
msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr "Ya existe %(model_name)s con estos %(field_labels)s."

#: django/forms/models.py
msgid "Please correct the duplicate data for %(field)s."
msgstr "Por favor, corrija los datos duplicados de %(field)s."

# ---------------------------------------------------------------------------
# Mensajes propios de Django que la plantilla puede mostrar
# ---------------------------------------------------------------------------

#: django/forms/fields.py
msgid "Please enter a valid URL."
msgstr "Por favor, introduzca una URL válida."

#: django/forms/fields.py
msgid "The submitted file is empty."
msgstr "El archivo enviado está vacío."

#: django/forms/fields.py
msgid "Enter a valid IPv4 or IPv6 address."
msgstr "Introduzca una dirección IPv4 o IPv6 válida."

#: django/forms/fields.py
msgid "Enter a valid IPv6 address."
msgstr "Introduzca una dirección IPv6 válida."

#: django/forms/fields.py
msgid "Enter a valid IPv4 address."
msgstr "Introduzca una dirección IPv4 válida."

#: django/contrib/auth/password_validation.py
msgid "Your password can’t be a commonly used password."
msgstr "Su contraseña no puede ser una contraseña de uso común."

#: django/contrib/auth/password_validation.py
msgid "Your password can’t be entirely numeric."
msgstr "Su contraseña no puede ser completamente numérica."

#: django/contrib/auth/password_validation.py
msgid "Your password can’t be too similar to your other personal information."
msgstr "Su contraseña no puede ser demasiado similar a su información personal."
